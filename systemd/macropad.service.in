[Unit]
Description=Macro pad daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/macropad run
Restart=on-failure
RestartSec=2
# Leave programs launched from actions.py running when the daemon restarts.
KillMode=process

[Install]
WantedBy=graphical-session.target
